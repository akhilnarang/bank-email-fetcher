[Unit]
Description=Financial Dashboard
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/akhil/financial-dashboard
# The app loads its own .env from the working directory (pydantic-settings).
# --no-sync: do not touch the venv at start. The systemd environment has no
# git auth, so a sync that had to fetch a git dep would fail; the installer and
# deploy.sh run `uv sync` in the user's environment instead.
ExecStart=/home/akhil/.local/bin/uv run --no-sync fastapi run
Restart=always
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=default.target
