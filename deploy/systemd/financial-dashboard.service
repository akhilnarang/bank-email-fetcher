[Unit]
Description=Financial Dashboard
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/akhil/financial-dashboard
# The app loads its own .env from the working directory (pydantic-settings).
# `uv run` syncs the venv to uv.lock on start, so a deploy is pull + restart.
ExecStart=/home/akhil/.local/bin/uv run fastapi run
Restart=always
RestartSec=5s
TimeoutStopSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=default.target
